   <listing># An attribute that writes when it is computed, and is never asked for.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+version 0.0.0
+spdx SPDX-License-Identifier: MIT
+unlint mandatory-package

[] &amp;gt; p13
  [] &amp;gt; noisy
    1 &amp;gt; quiet
    code. &amp;gt; loud
      posix
        &amp;quot;write&amp;quot;
        * 1 &amp;quot;x&amp;quot; 1
  [] &amp;gt; other
    2 &amp;gt; quiet
    3 &amp;gt; loud
  [n] &amp;gt; pick
    if. &amp;gt; @
      n.gt 0
      noisy
      other
  quiet. &amp;gt; @
    pick 1
</listing>
